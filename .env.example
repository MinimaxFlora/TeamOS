# TeamOS 部署配置
# 复制成 .env 后填写；make env 会自动生成 TEAMOS_SECRET_KEY。
# 这个文件会被 Git 忽略，不要把真实密钥提交到仓库。

# 镜像。GitHub Actions 推到 GHCR 后使用下面的地址。
TEAMOS_IMAGE=ghcr.io/minimaxflora/teamos:latest

# 32 字节主密钥：64 位十六进制。`make env` 会自动生成。
# 一旦开始使用就不要更换，否则已保存的模型/渠道密钥无法解密。
TEAMOS_SECRET_KEY=

# 对外端口与监听地址。
# 直接 IP 访问：BIND_ADDR=0.0.0.0
# 放到 Caddy/Nginx 后面：BIND_ADDR=127.0.0.1
BIND_ADDR=0.0.0.0
TEAMOS_PORT=8080

# 启用 HTTPS 后改成 true（Cookie 只走 HTTPS）。
COOKIE_SECURE=false
# 只有在 Node 前面有可信反向代理时才设为 true。
TRUST_PROXY=false
SESSION_DAYS=14

MODEL_MAX_TOKENS=4096
MEETING_MAX_TOKENS=1800
TZ=Asia/Shanghai

# ---- 可选：域名 + 自动 HTTPS（deploy/docker-compose.caddy.yml）----
# 启用后把 BIND_ADDR 改为 127.0.0.1、COOKIE_SECURE 改为 true、TRUST_PROXY 改为 true。
DOMAIN=
ACME_EMAIL=

# 构建时使用的 Hermes 版本（GitHub Actions 构建也需要可复现的版本）。
HERMES_IMAGE=nousresearch/hermes-agent:v0.22.5
NODE_VERSION=24.22.1

# ---- VPS 部署（make deploy / make vps-* 使用）----
# 建议先配置 SSH 密钥：ssh-copy-id -i ~/.ssh/teamos_vps.pub root@你的服务器
VPS_HOST=
VPS_USER=root
VPS_DIR=/opt/teamos
SSH_KEY=

# 当前 GHCR 包默认是私有的。需要时在 VPS 上执行：
#   echo <你的 PAT> | docker login ghcr.io -u <GitHub 用户名> --password-stdin
# 或把包的可见性改成 public（镜像本身不含任何密钥）。
GHCR_USER=
GHCR_TOKEN=
