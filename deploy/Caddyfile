{
	# 邮箱可选；填了会用于 ACME 通知。
	# email {$ACME_EMAIL}

	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy teamos:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
